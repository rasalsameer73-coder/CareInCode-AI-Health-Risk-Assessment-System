# Example environment variables for CareInCode backend
# Copy this file to backend/.env and fill in your real secrets

GEMINI_API_KEY=replace-with-your-gemini-api-key
MONGO_URI=replace-with-your-mongodb-uri
DATABASE_NAME=careincode
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
